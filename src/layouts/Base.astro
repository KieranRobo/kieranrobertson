---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** path segments after ~, e.g. [{ label: 'blog', href: '/blog/' }, { label: 'post.md' }] */
  crumbs?: { label: string; href?: string }[];
  current?: 'home' | 'blog';
  type?: 'website' | 'article';
}

const {
  title,
  description = `${profile.name}, ${profile.role.toLowerCase()} at ${profile.company} in ${profile.location}. Distributed systems, coding agents and developer tooling.`,
  crumbs = [],
  current,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="site-root" content="/" />
    <meta name="site-index" content="" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="frame">
      <header class="topbar">
        <nav class="cwd" aria-label="Breadcrumb">
          <a href="/">~</a>
          {crumbs.map((c) => (
            <>
              <span class="sep" aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
        <nav class="topnav" aria-label="Main">
          <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>blog</a>
          <a href="/#contact">contact</a>
          <a href="/rss.xml">rss</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <span>© {year} {profile.name}</span>
        <span>Built with Astro. Self-hosted in a container on a VPS.</span>
      </footer>
    </div>
  </body>
</html>
